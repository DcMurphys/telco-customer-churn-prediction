# Copy to .env (never commit .env) and fill in your own values.

# Remote MLflow tracking for `make train-online` (same values as the CI secrets).
# When MLFLOW_TRACKING_URI is empty, pipelines/train.py falls back to dagshub.init().
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# DagsHub token used by dagshub.init() (only when MLFLOW_TRACKING_URI is empty)
DAGSHUB_USER_TOKEN=

# Serving stack (optional overrides; defaults shown)
MLFLOW_INVOCATIONS_URL=http://127.0.0.1:5005/invocations
EXPORTER_HOST=127.0.0.1
EXPORTER_PORT=8080
EXPORTER_URL=http://127.0.0.1:8080
